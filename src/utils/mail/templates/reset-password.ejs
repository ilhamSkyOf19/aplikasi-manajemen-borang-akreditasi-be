<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <title>Reset Kata Sandi</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background: #f4f6f9;
      font-family: Arial, sans-serif;
    "
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="padding: 40px 20px"
    >
      <tr>
        <td align="center">
          <table
            width="550"
            cellpadding="0"
            cellspacing="0"
            style="
              background: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 3px 15px rgba(0, 0, 0, 0.05);
            "
          >
            <!-- HEADER -->
            <tr>
              <td
                align="center"
                style="background: #1e3a5f; padding: 35px 30px; color: white"
              >
                <!-- gunakan CID atau URL public -->
                <!-- <img
                  src="cid:logo"
                  width="65"
                  height="65"
                  alt="Logo"
                  style="display: block; margin-bottom: 15px"
                /> -->

                <div
                  style="font-size: 18px; font-weight: bold; line-height: 1.5"
                >
                  Aplikasi Manajemen Dokumentasi Borang
                </div>

                <div style="font-size: 13px; opacity: 0.85; margin-top: 6px">
                  Fakultas Ilmu Komputer<br />
                  Universitas Muhammadiyah Metro
                </div>
              </td>
            </tr>

            <!-- CONTENT -->
            <tr>
              <td style="padding: 35px">
                <p style="margin-top: 0; font-size: 15px; color: #333">
                  Yth. <strong><%= name %></strong>
                </p>

                <p style="color: #666; margin-bottom: 25px; font-size: 14px">
                  NIDN: <strong><%= nidn %></strong>
                </p>

                <p style="color: #444; line-height: 1.7; font-size: 14px">
                  Kami menerima permintaan reset kata sandi untuk akun:
                </p>

                <p style="margin-bottom: 25px; font-size: 14px">
                  <strong><%= email %></strong>
                </p>

                <!-- OTP BOX -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    background: #f7f9fc;
                    border: 1px dashed #d0d8e2;
                    border-radius: 10px;
                    text-align: center;
                    padding: 25px;
                    margin-bottom: 25px;
                  "
                >
                  <tr>
                    <td>
                      <div
                        style="
                          font-size: 13px;
                          color: #777;
                          margin-bottom: 10px;
                        "
                      >
                        Kode Aktivasi
                      </div>

                      <div
                        style="
                          font-size: 32px;
                          font-weight: bold;
                          letter-spacing: 8px;
                          color: #1e3a5f;
                        "
                      >
                        <%= activationCode %>
                      </div>

                      <div
                        style="margin-top: 12px; font-size: 12px; color: #888"
                      >
                        Berlaku selama
                        <strong>5 menit</strong>
                      </div>
                    </td>
                  </tr>
                </table>

                <!-- WARNING -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  style="
                    background: #fff7e8;
                    border-left: 4px solid #f0a500;
                    padding: 14px;
                    margin-bottom: 25px;
                  "
                >
                  <tr>
                    <td
                      style="font-size: 13px; color: #7d5d00; line-height: 1.6"
                    >
                      Jangan bagikan kode ini kepada siapa pun. Jika Anda tidak
                      melakukan permintaan reset kata sandi, abaikan email ini.
                    </td>
                  </tr>
                </table>

                <p style="color: #999; font-size: 12px; line-height: 1.7">
                  Email ini dikirim secara otomatis oleh sistem. Mohon tidak
                  membalas email ini.
                </p>
              </td>
            </tr>

            <!-- FOOTER -->
            <tr>
              <td
                align="center"
                style="
                  padding: 25px;
                  background: #fafafa;
                  border-top: 1px solid #eee;
                  color: #999;
                  font-size: 11px;
                  line-height: 1.8;
                "
              >
                Fakultas Ilmu Komputer Universitas Muhammadiyah Metro<br />
                Jl. Gatot Subroto No.100, Yosodadi, Metro Timur, Kota Metro,
                Lampung<br />
                fikom@ummetro.ac.id
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
