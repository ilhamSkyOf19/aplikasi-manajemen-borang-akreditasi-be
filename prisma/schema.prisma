generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
}

// =============================================
// MODEL YANG SUDAH ADA (ringkasan)
// =============================================

model User {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      Role     @default(tim_akreditasi)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi existing
  userTimAkreditasi UserTimAkreditasi[]
  // picPj             PicPj[]

  // Relasi baru: notifikasi yang DITERIMA oleh user ini
  notifications Notification[] @relation("NotificationRecipient")

  @@map("user")
}

enum Role {
  wakil_dekan_1
  kaprodi
  tim_akreditasi
}

model Kriteria {
  id               Int                 @id @default(autoincrement())
  kriteria         Int                 @unique
  namaKriteria     String
  revisi           Int                 @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  kebutuhanDokumen Kebutuhan_Dokumen[]

  @@map("kriteria")
}

model Pendekatan {
  id               Int                 @id @default(autoincrement())
  tahap            String
  keterangan       String              @unique
  kebutuhanDokumen Kebutuhan_Dokumen[]

  @@map("pendekatan")
}

model Kebutuhan_Dokumen {
  id           Int      @id @default(autoincrement())
  namaDokumen  String   @unique
  keterangan   String   @db.VarChar(1000)
  kriteriaId   Int
  pendekatanId Int
  status       Status   @default(menunggu)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  kriteria   Kriteria   @relation(fields: [kriteriaId], references: [id], onDelete: Cascade)
  pendekatan Pendekatan @relation(fields: [pendekatanId], references: [id], onDelete: Cascade)
  pic        Pic[]
  riwayat    Riwayat[]  @relation("RiwayatKebutuhanDokumen")

  @@map("kebutuhan_dokumen")
}

model TimAkreditasi {
  id                Int                 @id @default(autoincrement())
  namaTimAkreditasi String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  pic               Pic[]
  userTimAkreditasi UserTimAkreditasi[]

  @@map("tim_akreditasi")
}

model Pic {
  id                 Int      @id @default(autoincrement())
  timAkreditasiId    Int
  kebutuhanDokumenId Int
  status             Status   @default(menunggu)
  keterangan         String   @db.VarChar(1000)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  timAkreditasi    TimAkreditasi     @relation(fields: [timAkreditasiId], references: [id], onDelete: Cascade)
  kebutuhanDokumen Kebutuhan_Dokumen @relation(fields: [kebutuhanDokumenId], references: [id], onDelete: Cascade)
  // picPj            PicPj[]
  riwayat          Riwayat[]

  @@unique([timAkreditasiId, kebutuhanDokumenId])
  @@map("pic")
}

