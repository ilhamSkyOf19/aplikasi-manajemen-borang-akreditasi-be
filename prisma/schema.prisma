generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
}

// =============================================
// MODEL YANG SUDAH ADA (ringkasan)
// =============================================

model Dosen {
  id         Int      @id @default(autoincrement())
  nama       String
  email      String   @unique
  nidn       String   @unique
  password   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // relasi ke kriteria_pic
  kriteriaPic KriteriaPic[]

  // dosen role 
  dosenRole DosenRole[]

  // relasi ke file dokumen 
  file_dokumen FileDokumen[]

  // dokumen borang
  // dokumentasi_borang DokumentasiBorang[]
  riwayats       Riwayat[]
  activationCode ActivationCode?

  @@map("dosen")
}

// activation code 
model ActivationCode {
  id          Int      @id @default(autoincrement())
  dosen_id    Int      @unique
  code        String
  reset_token String?
  expired_at  DateTime
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  dosen Dosen @relation(fields: [dosen_id], references: [id], onDelete: Cascade)

  @@map("activation_code")
}

// dosen role 
model DosenRole {
  id         Int      @id @default(autoincrement())
  dosen_id   Int
  role       Role
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  dosen Dosen @relation(fields: [dosen_id], references: [id], onDelete: Cascade)

  @@unique([dosen_id, role]) // Mencegah duplikasi
  @@map("dosen_role")
}

// periode
model Periode {
  id         Int      @id @default(autoincrement())
  start_date DateTime
  end_date   DateTime
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // timeline 
  timeline Timeline[]

  // kriteria 
  kriteria                        Kriteria[]
  distribusiKebutuhanDokumentasis DistribusiKebutuhanDokumentasi?
  dokumenPanduan                  DokumenPanduan?

  // unique 
  @@unique([start_date, end_date])
  @@map("periode")
}

// timeline 
model Timeline {
  id                                       Int       @id @default(autoincrement())
  periode_id                               Int
  deadline_kebutuhan_dokumentasi           DateTime?
  deadline_dokumentasi_borang              DateTime?
  is_active_deadline_kebutuhan_dokumentasi Boolean   @default(false)
  is_active_deadline_dokumentasi_borang    Boolean   @default(false)
  created_at                               DateTime  @default(now())
  updated_at                               DateTime  @updatedAt

  // periode
  periode Periode @relation(fields: [periode_id], references: [id], onDelete: Cascade)

  // unique 
  @@unique([periode_id, deadline_kebutuhan_dokumentasi, deadline_dokumentasi_borang])
  @@map("timeline")
}

// dokumen panduan 
model DokumenPanduan {
  id               Int             @id @default(autoincrement())
  periode_id       Int             @unique
  nama_file        String
  id_file          String
  storage_provider StorageProvider @default(SISTEM)
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  periode Periode @relation(fields: [periode_id], references: [id], onDelete: Cascade)

  @@map("dokumen_panduan")
}

// kriteria 
model Kriteria {
  id            Int      @id @default(autoincrement())
  periode_id    Int
  kode_kriteria Int
  nama_kriteria String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  // periode
  periode Periode @relation(fields: [periode_id], references: [id], onDelete: Cascade)

  kebutuhan_dokumentasi KebutuhanDokumentasi[]

  // relasi ke kriteria_pic
  kriteriaPic KriteriaPic[]

  // unique
  @@unique([periode_id, kode_kriteria])
  @@unique([periode_id, nama_kriteria])
  @@map("kriteria")
}

// kriteria pic 
model KriteriaPic {
  id          Int      @id @default(autoincrement())
  kriteria_id Int
  dosen_id    Int
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  kriteria Kriteria @relation(fields: [kriteria_id], references: [id], onDelete: Cascade)
  dosen    Dosen    @relation(fields: [dosen_id], references: [id], onDelete: Cascade)

  @@unique([kriteria_id, dosen_id]) // Mencegah duplikasi
  @@map("kriteria_pic")
}

model Pendekatan {
  id                    Int                    @id @default(autoincrement())
  tahap                 String
  keterangan            String                 @unique
  kebutuhan_dokumentasi KebutuhanDokumentasi[]

  @@map("pendekatan")
}

enum Role {
  wakil_dekan_1
  kaprodi
  tim_akreditasi
}

model KebutuhanDokumentasi {
  id                            Int             @id @default(autoincrement())
  kriteria_id                   Int
  pendekatan_id                 Int
  nama_kebutuhan_dokumentasi_id Int
  tipe_dokumentasi              TipeDokumentasi @default(DEFAULT)
  status                        Status          @default(PENDING)
  keterangan                    String          @db.VarChar(1000)
  created_at                    DateTime        @default(now())
  updated_at                    DateTime        @updatedAt

  kriteria   Kriteria   @relation(fields: [kriteria_id], references: [id], onDelete: Cascade)
  pendekatan Pendekatan @relation(fields: [pendekatan_id], references: [id], onDelete: Cascade)

  nama_kebutuhan_dokumentasi NamaKebutuhanDokumentasi @relation(fields: [nama_kebutuhan_dokumentasi_id], references: [id], onDelete: Cascade)

  kebutuhan_dokumentasi_lokasi KebutuhanDokumentasiLokasi[]

  riwayat Riwayat[]

  dokumentasi_borang DokumentasiBorang?

  @@unique([kriteria_id, pendekatan_id, nama_kebutuhan_dokumentasi_id])
  @@map("kebutuhan_dokumentasi")
}

model Lokasi {
  id   Int    @id @default(autoincrement())
  nama String @unique

  kebutuhan_dokumentasi_lokasi KebutuhanDokumentasiLokasi[]

  @@map("lokasi")
}

// pivot 
model KebutuhanDokumentasiLokasi {
  id                       Int      @id @default(autoincrement())
  kebutuhan_dokumentasi_id Int
  lokasi_id                Int
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  kebutuhan_dokumentasi KebutuhanDokumentasi @relation(fields: [kebutuhan_dokumentasi_id], references: [id], onDelete: Cascade)
  lokasi                Lokasi               @relation(fields: [lokasi_id], references: [id], onDelete: Cascade)

  @@unique([kebutuhan_dokumentasi_id, lokasi_id])
  @@index([kebutuhan_dokumentasi_id])
  @@index([lokasi_id])
  @@map("kebutuhan_dokumentasi_lokasi")
}

model NamaKebutuhanDokumentasi {
  id                         Int    @id @default(autoincrement())
  nama_kebutuhan_dokumentasi String @unique

  kebutuhan_dokumentasi KebutuhanDokumentasi[]

  @@map("nama_kebutuhan_dokumentasi")
}

// dokumentasi borang 
model DokumentasiBorang {
  id                       Int      @id @default(autoincrement())
  kebutuhan_dokumentasi_id Int
  status                   Status?
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt

  kebutuhan_dokumentasi KebutuhanDokumentasi @relation(fields: [kebutuhan_dokumentasi_id], references: [id], onDelete: Cascade)

  // penelitian_detail DokumentasiBorangPenelitian?

  folders  FolderDokumen[]
  files    DokumentasiBorangFile[]
  riwayats Riwayat[]

  @@unique([kebutuhan_dokumentasi_id])
  @@index([kebutuhan_dokumentasi_id])
  @@map("dokumentasi_borang")
}

// folder dokumen 
model FolderDokumen {
  id                    Int      @id @default(autoincrement())
  dokumentasi_borang_id Int
  nama_folder           String
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  dokumentasi_borang DokumentasiBorang @relation(fields: [dokumentasi_borang_id], references: [id], onDelete: Cascade)

  files DokumentasiBorangFile[]

  @@unique([dokumentasi_borang_id, nama_folder])
  @@index([dokumentasi_borang_id])
  @@map("folder_dokumen")
}

// file dokumen 
model FileDokumen {
  id               Int             @id @default(autoincrement())
  file_id          String          @unique
  nama_file        String          @unique
  storage_provider StorageProvider @default(SISTEM)
  uploaded_by_id   Int
  keterangan       String          @db.VarChar(1000)
  tipe_file        TipeDokumentasi
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt
  is_active        Boolean         @default(false)

  uploaded_by Dosen @relation(fields: [uploaded_by_id], references: [id])

  dokumentasi_borang_files DokumentasiBorangFile[]

  default_detail    FileDokumenDefault?
  penelitian_detail FileDokumenPenelitian?

  @@index([uploaded_by_id])
  @@map("file_dokumen")
}

// dokumentasi borang file pivot 
model DokumentasiBorangFile {
  id                    Int      @id @default(autoincrement())
  dokumentasi_borang_id Int
  file_dokumen_id       Int
  folder_dokumen_id     Int?
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  // relasi 
  dokumentasi_borang DokumentasiBorang @relation(fields: [dokumentasi_borang_id], references: [id], onDelete: Cascade)

  file_dokumen FileDokumen @relation(fields: [file_dokumen_id], references: [id], onDelete: Cascade)

  folder_dokumen FolderDokumen? @relation(fields: [folder_dokumen_id], references: [id], onDelete: Cascade)

  @@unique([dokumentasi_borang_id, file_dokumen_id])
  @@index([dokumentasi_borang_id, folder_dokumen_id])
  @@map("dokumentasi_borang_file")
}

model FileDokumenDefault {
  id              Int      @id @default(autoincrement())
  file_dokumen_id Int      @unique
  nomor_dokumen   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  file_dokumen FileDokumen @relation(fields: [file_dokumen_id], references: [id], onDelete: Cascade)

  @@map("file_dokumen_default")
}

model FileDokumenPenelitian {
  id               Int      @id @default(autoincrement())
  file_dokumen_id  Int      @unique
  judul_penelitian String
  tahun            Int      @db.Year
  link_publikasi   String
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  file_dokumen FileDokumen @relation(fields: [file_dokumen_id], references: [id], onDelete: Cascade)

  @@map("file_dokumen_penelitian")
}

// distribusi 
model DistribusiKebutuhanDokumentasi {
  id         Int      @id @default(autoincrement())
  periode_id Int      @unique
  is_active  Boolean
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  periode Periode @relation(fields: [periode_id], references: [id], onDelete: Cascade)

  @@map("distribusi_kebutuhan_dokumentasi")
}

model Riwayat {
  id                       Int         @id @default(autoincrement())
  tipe_riwayat             TipeRiwayat
  dosen_id                 Int
  isRead                   Boolean     @default(false)
  keterangan               String      @db.VarChar(1000)
  created_at               DateTime    @default(now())
  updated_at               DateTime    @updatedAt
  kebutuhan_dokumentasi_id Int?
  dokumentasi_borang_id    Int?
  status                   Status
  // dokumentasi_borang Int?

  dosen Dosen @relation(fields: [dosen_id], references: [id], onDelete: Cascade)

  kebutuhan_dokumentasi_pic KebutuhanDokumentasi? @relation(fields: [kebutuhan_dokumentasi_id], references: [id], onDelete: Cascade)

  dokumentasi_borang DokumentasiBorang? @relation(fields: [dokumentasi_borang_id], references: [id], onDelete: Cascade)

  @@map("riwayat")
}

// // enum lokasi
enum StorageProvider {
  GDRIVE
  SISTEM
}

// enum tipe kebutuhan 
enum TipeDokumentasi {
  DEFAULT
  PENELITIAN
}

enum TipeRiwayat {
  DOKUMENTASI_BORANG
  KEBUTUHAN_DOKUMENTASI
}

// enum status
enum Status {
  PENDING
  REVISION
  APPROVED
}
