model Riwayat {
  id                  Int          @id @default(autoincrement())
  jenis               JenisRiwayat
  keterangan          String       @db.VarChar(1000)
  status              Status       @default(menunggu)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  picId               Int?
  kebutuhan_DokumenId Int?

  pic              Pic?                @relation(fields: [picId], references: [id], onDelete: Cascade)
  kebutuhanDokumen Kebutuhan_Dokumen?  @relation("RiwayatKebutuhanDokumen", fields: [kebutuhan_DokumenId], references: [id], onDelete: SetNull)
  flagRevisi       RiwayatFlagRevisi[]

  @@map("riwayat")
}

model RiwayatFlagRevisi {
  id         Int        @id @default(autoincrement())
  riwayatId  Int
  flagRevisi FlagRevisi

  riwayat Riwayat @relation(fields: [riwayatId], references: [id], onDelete: Cascade)

  @@map("riwayat_flag_revisi")
}

model UserTimAkreditasi {
  userId          Int
  timAkreditasiId Int

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  timAkreditasi TimAkreditasi @relation(fields: [timAkreditasiId], references: [id], onDelete: Cascade)

  @@id([timAkreditasiId, userId])
  @@map("user_tim_akreditasi")
}

enum Status {
  menunggu
  revisi
  disetujui
}

enum JenisRiwayat {
  dokumen_borang
  pic
}

enum FlagRevisi {
  dokumen_borang
  kebutuhan_dokumen
  pic
}

// =============================================
// ✅ MODEL BARU: NOTIFICATION
// =============================================

model Notification {
  id Int @id @default(autoincrement())

  // Penerima notifikasi
  recipientId Int
  recipient   User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Tipe notifikasi (menentukan ikon & routing di frontend)
  type NotificationType

  // Judul & isi pesan
  title   String @db.VarChar(255)
  message String @db.VarChar(1000)

  // Status baca
  isRead Boolean @default(false)

  // Referensi opsional ke entitas terkait (untuk deep-link di frontend)
  picId            Int?
  kebutuhanDokumen String?
  kriteria         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, isRead])
  @@map("notification")
}

enum NotificationType {
  // Dipicu oleh WD1 → diterima semua anggota
  KRITERIA_DITAMBAH
  KRITERIA_DIEDIT
  KRITERIA_DIHAPUS

  // Dipicu oleh Kaprodi → diterima WD1
  PIC_BARU_PERLU_VERIFIKASI
  PIC_DIREVISI_KAPRODI // Kaprodi mengedit ulang setelah revisi WD1

  // Dipicu oleh WD1 → diterima Kaprodi
  PIC_DISETUJUI_WD1
  PIC_DIREVISI_WD1 // WD1 meminta revisi ke Kaprodi
}
