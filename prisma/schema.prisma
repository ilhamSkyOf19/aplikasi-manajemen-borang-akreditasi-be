// enum tipe kebutuhan 
enum TipeDokumentasi {
  DEFAULT
  PENELITIAN
}

enum TipeRiwayat {
  DOKUMENTASI_BORANG
  KEBUTUHAN_DOKUMENTASI
}

// enum status
enum Status {
  PENDING
  REVISION
  APPROVED
}
