generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
}

// enum role 
enum Role {
  wakil_dekan_1
  kaprodi
  tim_akreditasi
}

// enum status
enum Status {
  menunggu
  revisi
  disetujui
}

// model user
model User {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      Role     @default(tim_akreditasi)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // tims 
  tims User_Tim_Akreditasi[]
  pic  Pic[]
}

// kriteria 
model Kriteria {
  id           Int      @id @default(autoincrement())
  kriteria     Int      @unique
  namaKriteria String
  revisi       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // relation kebutuhan dokumen
  dokumen Kebutuhan_Dokumen[]
}

model pendekatan {
  id         Int    @id @default(autoincrement())
  tahap      String
  keterangan String @unique

  // relation dokumen
  dokumen Kebutuhan_Dokumen[]
}

// anggota 
model Tim_Akreditasi {
  id                Int      @id @default(autoincrement())
  namaTimAkreditasi String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // anggota 
  user User_Tim_Akreditasi[]
  pic  Pic[]
}

// kebutuhan dokumen
model Kebutuhan_Dokumen {
  id          Int    @id @default(autoincrement())
  namaDokumen String @unique
  keterangan  String

  // relation kriteria
  kriteriaId   Int
  pendekatanId Int

  kriteria   Kriteria   @relation(fields: [kriteriaId], references: [id], onDelete: Cascade)
  pendekatan pendekatan @relation(fields: [pendekatanId], references: [id], onDelete: Cascade)

  pic Pic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// // ===== PIVOT TABLES ===== //

// tim & kebutuhan dokumen
model Pic {
  timAkreditasiId    Int
  kebutuhanDokumenId Int

  pjId Int

  // relation 
  timAkreditasi    Tim_Akreditasi    @relation(fields: [timAkreditasiId], references: [id], onDelete: Cascade)
  kebutuhanDokumen Kebutuhan_Dokumen @relation(fields: [kebutuhanDokumenId], references: [id], onDelete: Cascade)

  pj User @relation(fields: [pjId], references: [id], onDelete: Cascade)

  status Status

  @@id([timAkreditasiId, kebutuhanDokumenId])
}

model User_Tim_Akreditasi {
  userId          Int
  timAkreditasiId Int

  // user
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // tim akreditasi
  timAkreditasi Tim_Akreditasi @relation(fields: [timAkreditasiId], references: [id], onDelete: Cascade)

  @@id([timAkreditasiId, userId])
}
