generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
  engineType    = "binary"
}

datasource db {
  provider = "mysql"
}

// =============================================
// MODEL YANG SUDAH ADA (ringkasan)
// =============================================

model User {
  id        Int      @id @default(autoincrement())
  nama      String
  email     String   @unique
  password  String
  role      Role     @default(tim_akreditasi)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi existing
  userTimAkreditasi UserTimAkreditasi[]
  // dokumen borang
  dokumenBorang     DokumenBorang[]

  // Relasi baru: notifikasi yang DITERIMA oleh user ini
  notifications Notification[] @relation("NotificationRecipient")

  picDokumenAssigned PicDokumenBorang[] @relation("PicDokumenAssignedBy")

  @@map("user")
}

enum Role {
  wakil_dekan_1
  kaprodi
  tim_akreditasi
}

model Kriteria {
  id           Int      @id @default(autoincrement())
  kriteria     Int      @unique
  namaKriteria String
  revisi       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  pics         Pic[]

  @@map("kriteria")
}

model Pendekatan {
  id         Int    @id @default(autoincrement())
  tahap      String
  keterangan String @unique
  pics       Pic[]

  @@map("pendekatan")
}

model TimAkreditasi {
  id                Int      @id @default(autoincrement())
  namaTimAkreditasi String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Ganti pic Pic[] dengan junction table
  picTimAkreditasi  PicTimAkreditasi[]
  userTimAkreditasi UserTimAkreditasi[]

  @@map("tim_akreditasi")
}

model Pic {
  id           Int      @id @default(autoincrement())
  status       Status   @default(menunggu)
  keterangan   String   @db.VarChar(1000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  namaDokumen  String   @unique
  kriteriaId   Int
  pendekatanId Int

  kriteria   Kriteria   @relation(fields: [kriteriaId], references: [id], onDelete: Cascade)
  pendekatan Pendekatan @relation(fields: [pendekatanId], references: [id], onDelete: Cascade)

  picTimAkreditasi PicTimAkreditasi[]
  riwayat          Riwayat[]
  picDokumen       PicDokumenBorang[]

  @@map("pic")
}

model PicTimAkreditasi {
  id              Int      @id @default(autoincrement())
  picId           Int
  timAkreditasiId Int
  createdAt       DateTime @default(now())

  pic           Pic           @relation(fields: [picId], references: [id], onDelete: Cascade)
  timAkreditasi TimAkreditasi @relation(fields: [timAkreditasiId], references: [id], onDelete: Cascade)

  @@unique([picId, timAkreditasiId]) // Mencegah duplikasi 
  @@map("pic_tim_akreditasi")
}

model DokumenBorang {
  id           Int       @id @default(autoincrement())
  filename     String    @unique
  file_id      String?   @unique
  keterangan   String    @db.VarChar(1000)
  lokasi_file  LokasFile
  status       Status
  uploadedById Int
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  uploadedBy User               @relation(fields: [uploadedById], references: [id])
  picDokumen PicDokumenBorang[]

  @@map("dokumen_borang")
}

model PicDokumenBorang {
  id              Int      @id @default(autoincrement())
  picId           Int
  dokumenBorangId Int
  assignedById    Int
  createdAt       DateTime @default(now())

  pic           Pic           @relation(fields: [picId], references: [id], onDelete: Cascade)
  dokumenBorang DokumenBorang @relation(fields: [dokumenBorangId], references: [id], onDelete: Cascade)
  assignedBy    User          @relation("PicDokumenAssignedBy", fields: [assignedById], references: [id])

  @@unique([picId, dokumenBorangId])
  @@map("pic_dokumen_borang")
}

model Riwayat {
  id                  Int          @id @default(autoincrement())
  jenis               JenisRiwayat
  keterangan          String       @db.VarChar(1000)
  status              Status       @default(menunggu)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  picId               Int?
  kebutuhan_DokumenId Int?

  pic        Pic?                @relation(fields: [picId], references: [id], onDelete: Cascade)
  flagRevisi RiwayatFlagRevisi[]

  @@map("riwayat")
}

model RiwayatFlagRevisi {
  id         Int        @id @default(autoincrement())
  riwayatId  Int
  flagRevisi FlagRevisi

  riwayat Riwayat @relation(fields: [riwayatId], references: [id], onDelete: Cascade)

  @@map("riwayat_flag_revisi")
}

model UserTimAkreditasi {
  userId          Int
  timAkreditasiId Int

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  timAkreditasi TimAkreditasi @relation(fields: [timAkreditasiId], references: [id], onDelete: Cascade)

  @@id([timAkreditasiId, userId])
  @@map("user_tim_akreditasi")
}

// enum lokasi
enum LokasFile {
  GDRIVE
  SISTEM
}

enum Status {
  menunggu
  revisi
  disetujui
}

enum JenisRiwayat {
  dokumen_borang
  pic
}

enum FlagRevisi {
  dokumen_borang
  kebutuhan_dokumen
  pic
}

// =============================================
// ✅ MODEL BARU: NOTIFICATION
// =============================================

model Notification {
  id Int @id @default(autoincrement())

  // Penerima notifikasi
  recipientId Int
  recipient   User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  // Tipe notifikasi (menentukan ikon & routing di frontend)
  type NotificationType

  // Judul & isi pesan
  title   String @db.VarChar(255)
  message String @db.VarChar(1000)

  // Status baca
  isRead Boolean @default(false)

  // Referensi opsional ke entitas terkait (untuk deep-link di frontend)
  picId            Int?
  kebutuhanDokumen String?
  kriteria         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId, isRead])
  @@map("notification")
}

enum NotificationType {
  // Dipicu oleh WD1 → diterima semua anggota
  KRITERIA_DITAMBAH
  KRITERIA_DIEDIT
  KRITERIA_DIHAPUS

  // Dipicu oleh Kaprodi → diterima WD1
  PIC_BARU_PERLU_VERIFIKASI
  PIC_DIREVISI_KAPRODI // Kaprodi mengedit ulang setelah revisi WD1

  // Dipicu oleh WD1 → diterima Kaprodi
  PIC_DISETUJUI_WD1
  PIC_DIREVISI_WD1 // WD1 meminta revisi ke Kaprodi
}
